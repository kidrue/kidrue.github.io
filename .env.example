# 默认不设置 DATABASE_URL 时仅开发环境运行持久化的 PGlite，数据保存到 .data/postgres。
# 生产环境填写标准 PostgreSQL 地址，并运行 npm run db:migrate。
# DATABASE_URL=postgresql://kidrue:your-password@127.0.0.1:5433/kidrue_blog
PORT=3001
HOST=127.0.0.1
# 仅填写实际可信代理 IP/CIDR；自动 Docker 部署根据网络网关生成。
# TRUST_PROXY=127.0.0.1,::1
WEB_PORT=5174
PREVIEW_PORT=4173
# 默认代理至 PORT 指定的本机 API；仅在 API 单独运行于其他地址时填写。
# API_PROXY_URL=http://127.0.0.1:3001
NODE_ENV=development
# 生产环境必须设置强密码和至少 32 字符的会话密钥。
# ADMIN_PASSWORD=
# SESSION_SECRET=
# 单独部署 API 时设置博客公开域名，配合同源反向代理 /api 和 /uploads。
# PUBLIC_ORIGIN=https://blog.example.com
# Imgur 应用的 Client ID；默认匿名上传图片与视频。
IMGUR_CLIENT_ID=
# 可选：OAuth Access Token，配置后媒体归入对应 Imgur 账户。
IMGUR_ACCESS_TOKEN=
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
