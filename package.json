{
  "name": "kidrue-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @kidrue/web --",
    "dev:web": "npm run dev -w @kidrue/web --",
    "build": "node scripts/build-pages.mjs",
    "build:web": "npm run build",
    "build:pages": "npm run build",
    "preview": "npm run preview -w @kidrue/web --",
    "test": "npm run test:tooling && npm run test:web",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:web": "playwright test",
    "test:diary": "playwright test --config playwright.diary.config.ts",
    "test:static": "playwright test --config playwright.static.config.ts",
    "typecheck": "npm run typecheck -w @kidrue/web",
    "import:bilibili": "node scripts/import-bilibili.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "capture": "node scripts/capture-preview.mjs",
    "measure:navigation": "node scripts/measure-navigation.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  }
}
