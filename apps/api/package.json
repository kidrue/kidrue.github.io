{
  "name": "@kidrue/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev.mjs --api",
    "build": "npm run typecheck && vite build",
    "start": "node dist/production.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:dev": "tsx src/dev-database.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@kidrue/shared": "*",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "prisma": "^5.22.0",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5",
    "vite": "^6.4.0"
  }
}
