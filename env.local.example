# 本机部署配置。复制为 env.local 后填写；这两个文件都不由 Vite 自动读取。
# env.local 不提交、不打入镜像。先运行 npm run deploy:check。
# GitHub 仓库需已创建；当前项目尚未关联 Git 仓库。
GITHUB_REPOSITORY=

# 服务器公网 SSH 地址与用户。用户需为 root 或具备免密 sudo 权限。
ALIYUN_HOST=
ALIYUN_USER=root
ALIYUN_SSH_PORT=22
# 填本机文件路径，Windows 可使用 C:/Users/...；不要在此粘贴多行私钥。
# 私钥需为无口令的专用 OpenSSH 密钥，公钥已加入服务器 authorized_keys。
ALIYUN_SSH_PRIVATE_KEY_PATH=
# 填已通过阿里云控制台核对指纹的 known_hosts 文件路径。
ALIYUN_SSH_KNOWN_HOSTS_PATH=

ALIYUN_DEPLOY_PATH=/opt/kidrue-blog
ALIYUN_COMPOSE_PROJECT=kidrue-blog
ALIYUN_PLATFORM=linux/amd64
BLOG_WEB_PORT=18080
BLOG_API_PORT=13001

BLOG_DOMAIN=kidrue.top
# 真实公网 IPv4；不要填代理软件返回的 198.18.x.x。
ALIYUN_PUBLIC_IPV4=
CERTBOT_EMAIL=
# RAM 凭据仅用于 kidrue.top DNS，留在 Actions Runner，不传到服务器。
ALIYUN_DNS_ACCESS_KEY_ID=
ALIYUN_DNS_ACCESS_KEY_SECRET=
# 使用临时 STS 凭据时填写，否则留空。
ALIYUN_DNS_SECURITY_TOKEN=

# 初次部署后 POSTGRES_PASSWORD 必须保持稳定；修改需单独执行密码轮换。
# 可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 生成。
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=

# 可选；未填写时编辑器可保存文章，但不能自动上传媒体。
IMGUR_CLIENT_ID=
IMGUR_ACCESS_TOKEN=
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
